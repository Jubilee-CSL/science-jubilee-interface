# ── Docs build output ────────────────────────────────────────────────────────
docs/_build/

# ── GUI — generated experiment outputs ──────────────────────────────────────
# Dated experiment folders (e.g. 2026-04-24_experience/)
interface_graphique/experiment_deck/[0-9][0-9][0-9][0-9]-*/
# Flat generated files written to the experiment_deck root
interface_graphique/experiment_deck/*.json
interface_graphique/experiment_deck/*.dxf
interface_graphique/experiment_deck/*.txt

# LED pattern (generated by the GUI on every save)
interface_graphique/pattern_lumiere.json

# ── GUI — labware cache (large binary / downloadable files) ─────────────────
interface_graphique/labware_cache/

# ── 3-D build artefacts ──────────────────────────────────────────────────────
*.blend
*.blend1
# STL and SCAD files that are generated outputs (labware STLs stored in the
# dedicated labware repo should NOT be in this repo)
*.stl
